# Copy to .env to override defaults. No external API keys are needed:
# Open Library and Yahoo Finance are public.
# These are LOCAL DEV credentials only. Change them for anything shared.
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=admin
AIRFLOW_SECRET_KEY=local-dev-only-change-me
AIRFLOW_FERNET_KEY=
# On Linux set this to `id -u` so files written to ./data_lake are owned by you.
AIRFLOW_UID=50000

AIRFLOW_PORT=8080
API_PORT=8000
FRONTEND_PORT=3000
POSTGRES_PORT=5433
